# Sao chép thành file .env và điền giá trị.
# PostgreSQL local (Docker Desktop bật): docker compose -f ../docker-compose.local-db.yml up -d
# DATABASE_URL=postgresql://asms:asms_local_dev@localhost:5433/asms?schema=public
# Remote: thêm connect_timeout nếu mạng chậm (backend tự bổ sung mặc định 30s)
DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
PORT=4001
NODE_ENV=development
# Production: comma-separated origins, e.g. https://asms.example.com
CORS_ORIGINS=
TRUST_PROXY=true
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
