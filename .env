# Sao chép thành `.env` trên máy deploy — KHÔNG commit file `.env` thật.
# Tài liệu: docs/ASMS_trien-khai-day-du.html §09.

# --- Images (build local hoặc registry) ---
FRONTEND_IMAGE=asms-frontend:latest
BACKEND_IMAGE=asms-backend:latest
FRONTEND_PORT=8080
BACKEND_PORT=4001

# --- PostgreSQL (docker compose dùng các biến này cho cả service postgres và DATABASE_URL) ---
POSTGRES_USER=asms
POSTGRES_PASSWORD=asms_local_dev
POSTGRES_DB=asms

# --- Runtime ---
NODE_ENV=production
# DATABASE_URL được docker-compose.yml tự build từ POSTGRES_* ở trên.
# Không cần đặt ở đây cho môi trường Docker; chỉ đặt khi chạy ngoài Docker.
# DATABASE_URL=postgresql://USER:PASSWORD@db-host:5432/asms?schema=public

# JWT_SECRET: chuỗi ngẫu nhiên tối thiểu 32 ký tự. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ASMS_LocalDev_SecretKey_2026_MinLength32Chars!!
JWT_ACCESS_EXPIRES_IN=1h

# CORS: comma-separated origins. Production bắt buộc (backend sẽ từ chối boot nếu trống).
CORS_ORIGINS=http://localhost:8080

# Trust proxy header (khi chạy sau nginx). Bật cho production.
TRUST_PROXY=true

# --- Optional rate limits (bỏ comment để tinh chỉnh) ---
# GLOBAL_RATE_LIMIT_MAX=300
# GLOBAL_RATE_LIMIT_WINDOW_MS=60000
# AUTH_LOGIN_MAX_REQUESTS=10
